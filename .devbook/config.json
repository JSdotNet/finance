  },
  "phases": {
    "flow-code": {
      "phase-update-base": {
        "before": [
          "devbook:validate"
        ]
      },
      "phase-scope": {
        "skill": "devbook-openspec:spec",
        "after": [
          {
            "run": "devbook-openspec:status --replan",
            "on-failure": "required"
          }
        ]
      },
      "phase-plan": {
        "model": "fable",
        "effort": "high"
      },
      "phase-implement": {
        "model": "sonnet",
        "effort": "high"
      },
      "phase-review": {
        "model": "opus",
        "effort": "high"
      },
      "phase-build-test": {
        "model": "sonnet"
      },
      "phase-verify": {
        "model": "sonnet",
        "effort": "medium"
      },
      "phase-spec-check": {
        "skill": "devbook:verify-change",
        "model": "fable",
        "effort": "high"
      },
      "phase-create-pr": {},
      "phase-report-back": {
        "model": "haiku"
      },
      "phase-summary": {
        "after": [
          "devbook:update"
        ]
      }
    },
    "flow-spec": {
      "phase-update-base": {
        "before": [
          "devbook:validate"
        ]
      },
      "phase-scope": {},
      "phase-drafting": {
        "model": "sonnet",
        "effort": "medium"
      },
      "phase-drafting:arc42": {
        "model": "opus",
        "effort": "high"
      },
      "phase-drafting:domain": {
        "model": "opus",
        "effort": "high"
      },
      "phase-drafting:tech": {},
      "phase-drafting:design": {},
      "phase-drafting:ai": {},
      "phase-check-review": {},
      "phase-create-pr": {},
      "phase-report-back": {
        "model": "haiku"
      },
      "phase-summary": {
        "after": [
          "devbook:update"
        ]
      }
    }
  },
  "policy": {
    "commit.at": "gate"
  },
  "gates": [
    {
      "at": "create-pr",
      "when": "before",
      "purpose": "approval",
      "prompt": "Nothing here is pushed or opened as a pull request until asked. Push and open one now?",
      "show": "summary",
      "unattended": "block"
    }
  ],
