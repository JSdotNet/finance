  "id": "finance",
  "bindings": {
    "delivery.tracker": {
      "provider": "github"
    }
  },
  "phases": {
    "flow-code": {
      "phase-update-base": {
        "before": [
          "devbook:validate"
        ]
      },
      "phase-scope": {
        "agent": "architecture:architect"
      },
      "phase-plan": {
        "agent": "architecture:architect"
      },
      "phase-implement": {
        "agent": "csharp-coding:coding"
      },
      "phase-review": {},
      "phase-build-test": {
        "agent": "csharp-coding:coding"
      },
      "phase-verify": {
        "agent": "qa:qa"
      },
      "phase-spec-check": {
        "skill": "devbook:verify-change"
      },
      "phase-create-pr": {},
      "phase-report-back": {},
      "phase-summary": {
        "after": [
          "devbook:update"
        ]
      }
    },
    "flow-spec": {
      "phase-update-base": {
        "before": [
          "devbook:validate"
        ]
      },
      "phase-scope": {
        "agent": "architecture:architect"
      },
      "phase-drafting:arc42": {
        "agent": "architecture:architect"
      },
      "phase-drafting:domain": {
        "agent": "domain-design:domain-architect"
      },
      "phase-drafting:tech": {
        "agent": "architecture:architect"
      },
      "phase-drafting:design": {
        "agent": "ux-design:ux-designer"
      },
      "phase-drafting:ai": {},
      "phase-check-review": {},
      "phase-create-pr": {},
      "phase-report-back": {},
      "phase-summary": {
        "after": [
          "devbook:update"
        ]
      }
    }
  },
  "policy": {
    "commit.at": "gate"
  },
  "gates": [
    {
      "at": "create-pr",
      "when": "before",
      "purpose": "approval",
      "prompt": "Nothing here is pushed or opened as a pull request until asked. Push and open one now?",
      "show": "summary",
      "unattended": "block"
    }
  ],
